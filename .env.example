# Supabase (선택)
#
# 이 두 값이 없으면 앱은 LocalStorage 전용으로 동작합니다.
# 로그인/동기화 UI 는 아예 렌더되지 않습니다.
#
# 값 위치: Supabase 대시보드 > Project Settings > API
# anon key 는 클라이언트에 노출되어도 되는 공개 키입니다.
# RLS 가 켜져 있으면 남의 데이터에 접근할 수 없습니다.
# service_role 키는 필요 없습니다. 절대 여기에 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
